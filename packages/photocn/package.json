{
  "name": "photocn",
  "version": "0.1.0",
  "description": "GPU photo editor engine for React: adjustments, curves, LUT filters, crop, perspective, blur, EXIF-aware export. Pairs with the photocn shadcn/ui registry.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": ["image-editor", "photo-editor", "webgl", "react", "shadcn", "lut", "exif"],
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "default": "./dist/react/index.js" },
    "./hooks": { "types": "./dist/hooks/index.d.ts", "default": "./dist/hooks/index.js" },
    "./filters": { "types": "./dist/filters/index.d.ts", "default": "./dist/filters/index.js" },
    "./dom": { "types": "./dist/dom/index.d.ts", "default": "./dist/dom/index.js" },
    "./gl": { "types": "./dist/gl/index.d.ts", "default": "./dist/gl/index.js" },
    "./exif": { "types": "./dist/exif/index.d.ts", "default": "./dist/exif/index.js" },
    "./worker": { "types": "./dist/worker/index.d.ts", "default": "./dist/worker/index.js" },
    "./worker/entry": "./dist/editor.worker.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.0",
    "happy-dom": "^15",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.2"
  }
}
